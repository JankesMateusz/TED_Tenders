{
  "name": "ted-eu",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "axios": "^1.9.0",
    "firebase": "^11.10.0",
    "react": "^19.1.0",
    "react-datepicker": "^8.4.0",
    "react-dom": "^19.1.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "emulators": "firebase emulators:start --project demo-tenders",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules-test \"node --test tests/firestore.rules.test.mjs\"",
    "test:unit": "npm --prefix functions run build && node --test tests/mappers.test.mjs",
    "test:functions": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-tenders \"node --test --test-concurrency=1 tests/invite.integration.test.mjs tests/refresh.integration.test.mjs\"",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "not ie 11",
      "not ie_mob 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "last 1 edge version",
      "last 2 ios_saf version",
      "last 2 android version"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "autoprefixer": "^10.4.21",
    "firebase-tools": "^14.4.0",
    "postcss": "^8.5.3",
    "puppeteer": "^24.9.0"
  }
}
