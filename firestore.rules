rules_version = '2';

// TYMCZASOWO (otwarty dostęp): dostęp ma każdy zalogowany, także anonimowo (aplikacja loguje
// odwiedzających anonimowo). Docelowo wraca wymóg roli z custom claim (`role`): przywróć
// `hasRole()` do wersji sprzed commita „Temporarily open access” (git revert).
service cloud.firestore {
  match /databases/{database}/documents {

    function hasRole() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.get('role', null) == 'admin';
    }

    // Wspólny status przetargu: albo komplet poprawnych pól ustawiony przez zalogowaną osobę
    // (`statusAt` to czas serwera), albo komplet pól usunięty (zdjęcie statusu).
    function statusFieldsAreSet() {
      let data = request.resource.data;
      return data.status in ['toEnter', 'entered', 'notToEnter', 'toClarify']
        && data.statusBy == request.auth.uid
        && data.statusByEmail == request.auth.token.get('email', 'Gość')
        && data.statusAt == request.time;
    }

    function statusFieldsAreCleared() {
      let data = request.resource.data;
      return !('status' in data) && !('statusBy' in data)
        && !('statusByEmail' in data) && !('statusAt' in data);
    }

    // Wspólne etykiety: lista 1–4 różnych znanych etykiet (PROSTY i TRUDNY się wykluczają)
    // z autorem i czasem serwera, albo komplet pól usunięty.
    function labelFieldsAreSet() {
      let data = request.resource.data;
      return data.labels is list
        && data.labels.size() >= 1
        && data.labels.toSet().size() == data.labels.size()
        && data.labels.toSet().hasOnly(['important', 'simple', 'hard', 'missingDocs'])
        && !data.labels.toSet().hasAll(['simple', 'hard'])
        && data.labelsBy == request.auth.uid
        && data.labelsByEmail == request.auth.token.get('email', 'Gość')
        && data.labelsAt == request.time;
    }

    function labelFieldsAreCleared() {
      let data = request.resource.data;
      return !('labels' in data) && !('labelsBy' in data)
        && !('labelsByEmail' in data) && !('labelsAt' in data);
    }

    // Profile użytkowników: zapis tylko przez Cloud Functions (Admin SDK).
    match /users/{uid} {
      allow read: if isAdmin() || (hasRole() && request.auth.uid == uid);
      allow write: if false;

      // Gwiazdki są indywidualne: pełna kopia przetargu, bez TTL, dostęp tylko dla właściciela.
      match /favorites/{tenderId} {
        allow read, write: if hasRole() && request.auth.uid == uid;
      }
    }

    // Przetargi: odczyt dla członków; dokumenty zakłada wyłącznie Cloud Function `refreshTenders`.
    // Klient może jedynie zmienić pola wspólnego statusu i etykiet istniejącego przetargu.
    match /tenders/{tenderId} {
      allow read: if hasRole();
      allow create, delete: if false;
      allow update: if hasRole()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'statusBy', 'statusByEmail', 'statusAt',
                      'labels', 'labelsBy', 'labelsByEmail', 'labelsAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['status', 'statusBy', 'statusByEmail', 'statusAt'])
            || statusFieldsAreSet() || statusFieldsAreCleared())
        && (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['labels', 'labelsBy', 'labelsByEmail', 'labelsAt'])
            || labelFieldsAreSet() || labelFieldsAreCleared());
    }

    // Komentarze do przetargów: wspólne dla członków, tylko do dodawania i usuwania (bez edycji).
    // Komentarz wygasa po miesiącu (TTL na `expireAt`), razem z przetargiem, którego dotyczy.
    // Autora i e-mail bierzemy z tokenu, a `publicationDate` musi zgadzać się z przetargiem,
    // bo po tej dacie aplikacja nasłuchuje komentarzy całego zakresu dni.
    match /comments/{commentId} {
      allow read: if hasRole();
      allow create: if hasRole()
        && request.resource.data.keys().hasOnly(['tenderId', 'publicationDate', 'text', 'authorUid', 'authorEmail', 'createdAt', 'expireAt'])
        && request.resource.data.keys().hasAll(['tenderId', 'publicationDate', 'text', 'authorUid', 'authorEmail', 'createdAt', 'expireAt'])
        && request.resource.data.tenderId is string
        && exists(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId))
        && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.publicationDate
            == request.resource.data.publicationDate
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.get('email', 'Gość')
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt <= request.time + duration.value(31, 'd');
      allow update: if false;
      allow delete: if hasRole() && resource.data.authorUid == request.auth.uid;
    }

    // Ręczne decyzje o zamawiających (dokument o identyfikatorze równym NIP-owi): `hidden` ukrywa jego ogłoszenia,
    // `visible` je przywraca, a brak dokumentu oznacza, że decyduje automatyczna klasyfikacja sektora.
    // Wspólne dla członków; nie usuwamy dokumentów, bo przywrócenie to decyzja `visible`.
    match /advertisers/{nip} {
      allow read: if hasRole();
      allow create, update: if hasRole()
        && nip.matches('^[0-9]{10}$')
        && request.resource.data.keys().hasOnly(['decision', 'name', 'updatedBy', 'updatedByEmail', 'updatedAt'])
        && request.resource.data.keys().hasAll(['decision', 'name', 'updatedBy', 'updatedByEmail', 'updatedAt'])
        && request.resource.data.decision in ['hidden', 'visible']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 300
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedByEmail == request.auth.token.get('email', 'Gość')
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Obecność: każdy zalogowany zapisuje tylko własny dokument (puls `lastSeen` co ok. minutę),
    // odczyt ma wyłącznie admin. Dokument wygasa przez TTL na `expireAt`.
    match /presence/{uid} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeen', 'expireAt', 'isAnonymous', 'email'])
        && request.resource.data.keys().hasAll(['lastSeen', 'expireAt', 'isAnonymous'])
        && request.resource.data.lastSeen == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt <= request.time + duration.value(2, 'h')
        && request.resource.data.isAnonymous == (request.auth.token.firebase.sign_in_provider == 'anonymous')
        && (request.resource.data.isAnonymous || request.resource.data.email == request.auth.token.get('email', null));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Dzienniki odświeżeń (które dni zostały już pobrane): odczyt dla członków, zapis tylko z Cloud Function.
    match /refreshLog/{day} {
      allow read: if hasRole();
      allow write: if false;
    }

    // Migawki ocen przetargów (bez TTL, materiał do oceny wstępnej klasyfikacji): zapisuje i czyta tylko serwer.
    match /labelSnapshots/{docId} {
      allow read, write: if false;
    }

    // Zdarzenia do podsumowania „od ostatniej wizyty” (zmiana statusu, nowe dokumenty): odczyt dla członków,
    // zapis tylko z Cloud Function. Wpisy wygasają przez TTL na `expireAt`.
    match /events/{eventId} {
      allow read: if hasRole();
      allow write: if false;
    }

    // Stan użytkownika: moment ostatniej wizyty (`lastSeenAt`, czas serwera), od którego liczymy podsumowanie.
    // Każdy zapisuje i czyta tylko własny dokument.
    match /userState/{uid} {
      allow read: if hasRole() && request.auth.uid == uid;
      allow create, update: if hasRole() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSeenAt'])
        && request.resource.data.lastSeenAt == request.time;
      allow delete: if false;
    }

    // Pozostałe kolekcje (m.in. blokada odświeżania `meta`) są zamknięte.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
