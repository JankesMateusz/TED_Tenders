rules_version = '2';

// Tymczasowo: pełna blokada dostępu klientów. Właściwe reguły (role, przetargi, ulubione)
// powstaną w etapie 1 planu (docs/plan.md).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
