rules_version = '2';

// Dostęp daje wyłącznie rola z custom claim (`role`), nadawana przez Cloud Functions.
// Samo zalogowanie nie wystarcza: konto może założyć każdy, kto zna publiczny klucz API.
service cloud.firestore {
  match /databases/{database}/documents {

    function hasRole() {
      return request.auth != null && request.auth.token.get('role', null) in ['admin', 'member'];
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.get('role', null) == 'admin';
    }

    // Wspólny status przetargu: albo komplet poprawnych pól ustawiony przez zalogowaną osobę
    // (`statusAt` to czas serwera), albo komplet pól usunięty (zdjęcie statusu).
    function statusFieldsAreSet() {
      let data = request.resource.data;
      return data.status in ['toEnter', 'entered', 'notToEnter', 'toClarify']
        && data.statusBy == request.auth.uid
        && data.statusByEmail == request.auth.token.get('email', null)
        && data.statusAt == request.time;
    }

    function statusFieldsAreCleared() {
      let data = request.resource.data;
      return !('status' in data) && !('statusBy' in data)
        && !('statusByEmail' in data) && !('statusAt' in data);
    }

    // Profile użytkowników: zapis tylko przez Cloud Functions (Admin SDK).
    match /users/{uid} {
      allow read: if isAdmin() || (hasRole() && request.auth.uid == uid);
      allow write: if false;

      // Gwiazdki są indywidualne: pełna kopia przetargu, bez TTL, dostęp tylko dla właściciela.
      match /favorites/{tenderId} {
        allow read, write: if hasRole() && request.auth.uid == uid;
      }
    }

    // Przetargi: odczyt dla członków; dokumenty zakłada wyłącznie Cloud Function `refreshTenders`.
    // Klient może jedynie zmienić pola wspólnego statusu istniejącego przetargu.
    match /tenders/{tenderId} {
      allow read: if hasRole();
      allow create, delete: if false;
      allow update: if hasRole()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'statusBy', 'statusByEmail', 'statusAt'])
        && (statusFieldsAreSet() || statusFieldsAreCleared());
    }

    // Komentarze do przetargów: wspólne dla członków, tylko do dodawania i usuwania (bez edycji).
    // Komentarz wygasa po miesiącu (TTL na `expireAt`), razem z przetargiem, którego dotyczy.
    // Autora i e-mail bierzemy z tokenu, a `publicationDate` musi zgadzać się z przetargiem,
    // bo po tej dacie aplikacja nasłuchuje komentarzy całego zakresu dni.
    match /comments/{commentId} {
      allow read: if hasRole();
      allow create: if hasRole()
        && request.resource.data.keys().hasOnly(['tenderId', 'publicationDate', 'text', 'authorUid', 'authorEmail', 'createdAt', 'expireAt'])
        && request.resource.data.keys().hasAll(['tenderId', 'publicationDate', 'text', 'authorUid', 'authorEmail', 'createdAt', 'expireAt'])
        && request.resource.data.tenderId is string
        && exists(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId))
        && get(/databases/$(database)/documents/tenders/$(request.resource.data.tenderId)).data.publicationDate
            == request.resource.data.publicationDate
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.get('email', null)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expireAt is timestamp
        && request.resource.data.expireAt > request.time
        && request.resource.data.expireAt <= request.time + duration.value(31, 'd');
      allow update: if false;
      allow delete: if hasRole() && resource.data.authorUid == request.auth.uid;
    }

    // Dzienniki odświeżeń (które dni zostały już pobrane): odczyt dla członków, zapis tylko z Cloud Function.
    match /refreshLog/{day} {
      allow read: if hasRole();
      allow write: if false;
    }

    // Pozostałe kolekcje (m.in. blokada odświeżania `meta`) są zamknięte.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
